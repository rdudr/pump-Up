# Gmail SMTP used by /api/sync/queue to email the Excel report to the team.
# For Gmail, SMTP_PASS must be an App Password (Google Account → Security → App passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"

# Optional: comma-separated list that replaces the built-in team list.
# REPORT_RECIPIENTS="someone@iitgn.ac.in,other@iitgn.ac.in"

# Optional: server the Android app sends reports to (defaults to https://pump-up.vercel.app)
# NEXT_PUBLIC_API_URL="https://pump-up.vercel.app"
